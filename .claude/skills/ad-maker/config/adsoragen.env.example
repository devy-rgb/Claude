# Adsora Gen — the skill's own key file. tools/adsoragen.mjs reads THIS file first,
# then the process env, then ./.env in the working folder, then the house env files.
#
#   cp config/adsoragen.env.example config/adsoragen.env   → then fill the REQUIRED lines
#
# Fastest fill: every value below also lives in the Adsora webchat Vercel project.
# In your own terminal (not in chat — the values must never pass through it):
#
#   cd ~/Documents/webchat-vercel && vercel env pull /tmp/adsora-prod.env --environment=production
#   node ~/.claude/skills/competitor-ad-remix-engine/tools/adsoragen.mjs --import-env /tmp/adsora-prod.env
#   rm /tmp/adsora-prod.env
#   node ~/.claude/skills/competitor-ad-remix-engine/tools/adsoragen.mjs --health
#
# --import-env writes the RUNPOD_* lines here and the four H3 graphs into
# config/adsoragen/*.json, printing only names and lengths. Or paste by hand from
# the RunPod console (Settings → API Keys; Serverless → the endpoint's id).
#
# The filled file stays in the INSTALLED copy (~/.claude/skills/…) only. The
# distributable copy in ~/Downloads ships this .example and nothing else; a key in
# a shared folder is a leaked key.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# RunPod API key (starts rpa_). Paste after the = with no quotes.
RUNPOD_API_KEY=

# The serverless endpoint running worker-comfyui + MiniMax H3.
# 7ud39rwzgljmtj = "adsora-gen": US-NC-1, network volume q00nagvebo (H3 weights +
# runtime/boot.sh), min 0 / max 2 workers, 90s idle. Answered /health 2026-09-04.
RUNPOD_VIDEO_ENDPOINT_ID=7ud39rwzgljmtj

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Fallback endpoints, tried in order when the primary refuses a submit (5xx / 429 /
# unreachable). Two more endpoints answered /health on 2026-09-04 — t5adchw32irgan
# and b497kbskl1yduu — but their roles were not confirmed; check them in the RunPod
# console before enabling a line.
# RUNPOD_VIDEO_ENDPOINT_ID_2=
# RUNPOD_VIDEO_ENDPOINT_ID_3=

# GPU rate used to turn RunPod's executionTime into the real dollars written to
# results.json and the run log. The pool is expensive-first (BLACKWELL_96 $3.49 →
# ADA_24 $1.10 → AMPERE_24 $0.69) because H3's 21GB DiT + 27GB encoder need the
# big card, and RunPod does not say which card ran — so the top rate is assumed.
RUNPOD_GPU_HOURLY=3.49

# Sampling steps. Faces (avatar) and fast motion (video) both soften when low.
RUNPOD_S2V_STEPS=16
RUNPOD_VIDEO_STEPS=16

# Cold-start ETA printed while a job waits for a worker.
RUNPOD_VIDEO_ETA_SEC=150

# ── GRAPHS ────────────────────────────────────────────────────────────────────
# The ComfyUI "Export (API)" graphs the worker runs. Preferred home:
#   config/adsoragen/h3-t2v.json · h3-i2v.json · h3-s2v.json · h3-s2v-chain.json
# (--import-env writes them). Alternatively paste each as one double-quoted line:
# ADSORA_WORKFLOW_H3_T2V="{...}"
# ADSORA_WORKFLOW_H3_I2V="{...}"
# ADSORA_WORKFLOW_H3="{...}"          avatar: reference face + voice (s2v)
# ADSORA_WORKFLOW_H3_CHAIN="{...}"    avatar clips 2..N continuing the shot (optional; falls back to H3)
